# OpenRouter API Key for AI Route Optimization
# Na Vercel, cadastre em Settings > Environment Variables, nunca no código
OPENROUTER_API_KEY=

# Optional: Model name (e.g. openai/gpt-4o-mini, deepseek/deepseek-chat, google/gemini-2.5-flash, anthropic/claude-3.5-haiku)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Server & Dev Settings
PORT=3000
DISABLE_HMR=
